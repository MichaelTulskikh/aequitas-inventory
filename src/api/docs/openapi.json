        "required": [
          "id",
          "shipment_number",
          "status",
          "requester_name",
          "created_at",
          "line_count"
        ],
        "additionalProperties": false
      },
      "DashboardRecentFulfilledShipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "shipment_number": {
            "type": "string"
          },
          "requester_name": {
            "type": "string",
            "nullable": true
          },
          "fulfilled_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "shipment_number",
          "requester_name",
          "fulfilled_at"
        ],
        "additionalProperties": false
      },
      "DashboardInventoryByCategory": {
        "type": "object",
        "properties": {
          "category_id": {
            "type": "string",
            "nullable": true
          },
          "category_name": {
            "type": "string"
          },
          "total_available_quantity": {
            "type": "number"
          },
          "item_count": {
            "type": "number"
          }
