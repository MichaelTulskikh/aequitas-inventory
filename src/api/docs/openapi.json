{
  "openapi": "3.0.3",
  "info": {
    "title": "Warehouse API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "DashboardMe": {
        "type": "object",
        "properties": {
          "is_privileged": {
            "type": "boolean"
          }
        },
        "required": [
          "is_privileged"
        ],
        "additionalProperties": false
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "shipments_by_status": {
            "$ref": "#/components/schemas/DashboardShipmentsByStatus"
          },
          "my_active_shipments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardActiveShipment"
            }
          },
          "recent_fulfilled_shipments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardRecentFulfilledShipment"
            }
          },
          "inventory_by_category": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardInventoryByCategory"
            }
          },
          "low_stock_lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardLowStockLot"
            }
          },
          "expiring_soon_lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardExpiringSoonLot"
            }
          },
          "recent_receives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardInventoryTxn"
            }
          },
          "recent_adjustments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardInventoryTxn"
            }
          }
        },
        "required": [
          "shipments_by_status",
          "my_active_shipments",
          "recent_fulfilled_shipments",
          "inventory_by_category",
          "low_stock_lots",
          "expiring_soon_lots",
          "recent_receives",
          "recent_adjustments"
        ],
        "additionalProperties": false
      },
      "DashboardShipmentsByStatus": {
        "type": "object",
        "properties": {
          "draft": {
            "type": "number"
          },
          "submitted": {
            "type": "number"
          },
          "approved": {
            "type": "number"
          },
          "fulfilled": {
            "type": "number"
          },
          "cancelled": {
            "type": "number"
          },
          "rejected": {
            "type": "number"
          }
        },
        "required": [
          "draft",
          "submitted",
          "approved",
          "fulfilled",
          "cancelled",
          "rejected"
        ],
        "additionalProperties": false
      },
      "DashboardActiveShipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "shipment_number": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "requester_name": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "line_count": {
            "type": "number"
          }
