          "category_id",
          "category_name",
          "total_available_quantity",
          "item_count"
        ],
        "additionalProperties": false
      },
      "DashboardLowStockLot": {
        "type": "object",
        "properties": {
          "inventory_lot_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "available_quantity": {
            "type": "number"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true
          }
        },
        "required": [
          "inventory_lot_id",
          "item_id",
          "item_name",
          "location_name",
          "available_quantity",
          "attributes"
        ],
        "additionalProperties": false
      },
      "DashboardExpiringSoonLot": {
        "type": "object",
        "properties": {
          "inventory_lot_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "available_quantity": {
            "type": "number"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true
          },
          "expiration_date": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "inventory_lot_id",
          "item_id",
          "item_name",
          "location_name",
          "available_quantity",
          "attributes",
          "expiration_date"
        ],
        "additionalProperties": false
      },
      "DashboardInventoryTxn": {
        "type": "object",
        "properties": {
          "inventory_txn_id": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "location_name": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "inventory_txn_id",
          "occurred_at",
          "item_name",
          "quantity",
          "location_name",
          "reason"
        ],
        "additionalProperties": false
      },
      "GetDashboardSummaryResponse": {
        "type": "object",
        "properties": {
          "me": {
            "$ref": "#/components/schemas/DashboardMe"
          },
          "summary": {
            "$ref": "#/components/schemas/DashboardSummary"
          }
        },
        "required": [
          "me",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
